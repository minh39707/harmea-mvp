{
  "name": "harmea-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "env:prod": "node scripts/make-prod-env.mjs",
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace @harmea/web",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait db",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.ts",
    "db:backfill-lookup": "node --env-file-if-exists=.env scripts/backfill-lookup.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "typecheck": "tsc -p tsconfig.tools.json && npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "start:api": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "routes:check": "node scripts/check-routes.mjs",
    "test:smoke": "node --env-file-if-exists=.env tests/smoke.mjs",
    "test:router": "node --test tests/router.mjs",
    "test:api": "node --env-file-if-exists=.env --test tests/api-integration.mjs",
    "test:editor": "node --test tests/editor.mjs",
    "test:checkout": "node --env-file-if-exists=.env --test tests/checkout.mjs",
    "test:admin": "node --env-file-if-exists=.env --test tests/admin.mjs",
    "test:admin-extended": "node --env-file-if-exists=.env --test tests/admin-extended.mjs",
    "test:setup": "node --env-file-if-exists=.env --test tests/setup.mjs",
    "test:runtime": "node --test tests/runtime.mjs",
    "test:storage": "node --env-file-if-exists=.env --test tests/storage.mjs",
    "test:storage:s3": "node --env-file-if-exists=.env --test tests/storage-s3.mjs",
    "test:docker-fixture": "node --env-file-if-exists=.env --test tests/docker-fixture.mjs",
    "test:prod-env": "node --test tests/prod-env.mjs",
    "test:snapshots": "node --test tests/snapshots.mjs",
    "storage:migrate-s3": "node --env-file-if-exists=.env scripts/migrate-uploads-to-s3.mjs",
    "demo:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/node": "^24.0.0",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
