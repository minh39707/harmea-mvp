# Production/container environment template. Copy to a private .env and replace CHANGE_ME values.
# Required: runtime mode and public origin; APP_URL must be the site's origin, without a path.
NODE_ENV=production
PORT=3000
APP_URL=https://harmea.introd.xyz
# Set the exact tested Docker Hub version before pulling/releasing. Not a secret.
# APP_IMAGE=your-dockerhub-user/harmea-web:vN

# Required: application database connection. In Compose, use host "db".
DATABASE_URL=mysql://harmea:CHANGE_ME@db:3306/harmea
DB_CONNECTION_LIMIT=10

# Required by the MySQL service in docker-compose.yml. Keep both passwords private.
MYSQL_DATABASE=harmea
MYSQL_USER=harmea
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_BUFFER_POOL=1G

# Required: uploads stay in the private named volume, outside the web root.
UPLOAD_DIR=/app/storage/uploads

# Optional storage driver. Local is the default; existing volume data remains private.
STORAGE_DRIVER=local
# For STORAGE_DRIVER=s3, both values are required. Bucket and role are supplied by the operator.
# Use a private bucket with Block Public Access and SSE-S3; never put AWS access keys here.
# S3_BUCKET=CHANGE_ME
# AWS_REGION=ap-southeast-1

# Required secret for order lookup. Generate at least 32 random bytes; do not reuse passwords.
LOOKUP_SECRET=CHANGE_ME

# Optional image processing limits.
PHOTO_MAX_EDGE=2400
PHOTO_JPEG_QUALITY=82

# Optional. If enabled in production, protect /admin and /api/admin at the reverse proxy.
# ADMIN_ENABLED=true

# Local-only development/test values. npm run setup adds active values to its private .env.
# MYSQL_PORT=3306
# TEST_DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3306/mysql
