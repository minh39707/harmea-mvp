# Run npm run setup to create .env with random local credentials.
# pglite: one local process. postgres: Docker/server via DATABASE_URL.
DB_DRIVER=pglite
DATABASE_URL=
DATA_DIR=./storage/db
UPLOAD_DIR=./storage/uploads
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
POSTGRES_USER=harmea
POSTGRES_DB=harmea
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_VALUE
ADMIN_USERNAME=admin
# scrypt format: hex salt:hex derived key. Auth is planned, not implemented.
ADMIN_PASSWORD_HASH=
