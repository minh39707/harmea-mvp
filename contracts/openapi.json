          "403": {
            "description": "Origin không được phép hoặc không đủ quyền.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "ORDER_OR_ASSET_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "harmea_admin"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed",
          "producing",
          "shipping",
          "completed",
          "cancelled"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          },
          "service": {
            "const": "harmea-api",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "Crop": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "description": "Vùng crop trên ảnh gốc đã chuẩn hóa chiều EXIF. x+width<=1 và y+height<=1. Backend kiểm tra tổng; không suy ra từ ảnh preview."
      },
      "Design": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD; ngày hợp lệ và không sau ngày hiện tại Asia/Saigon."
          },
          "place": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "commemorativeDate": {
            "type": "string",
            "format": "date",
            "description": "Ngày in trên thẻ, có thể ở quá khứ hoặc tương lai."
          },
          "signatureText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Chữ ký nhập bằng bàn phím trong MVP; không xác thực danh tính."
          },
          "musicUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "HTTPS, không credentials hoặc port tùy chỉnh. Exact-host allowlist: open.spotify.com, music.youtube.com, www.youtube.com, youtube.com, youtu.be, soundcloud.com, www.soundcloud.com. Backend chỉ phân tích URL, không fetch và không bảo đảm bài hát còn tồn tại."
          },
          "crop": {
            "$ref": "#/components/schemas/Crop"
          }
        },
        "required": [
          "fullName",
          "dateOfBirth",
          "place",
          "commemorativeDate",
          "signatureText",
          "musicUrl",
          "crop"
        ]
      },
      "Recipient": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9]{8,15}$",
            "description": "Chuỗi đã trim, chỉ dấu + tùy chọn và 8–15 chữ số; không tự suy đoán quốc gia."
          },
          "address": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "phone",
          "address"
        ]
      },
      "Product": {
        "type": "object",
