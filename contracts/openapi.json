    "/api/admin/orders/{id}/assets/{kind}": {
      "get": {
        "x-implementation-status": "planned",
        "operationId": "downloadOrderAsset",
        "summary": "Tải tệp riêng tư qua kiểm tra session.",
        "security": [
          {
            "adminCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "photo",
                "preview"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream tệp; Content-Disposition:attachment, Cache-Control:private,no-store; không public static uploads.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập hoặc session hết hạn.",
