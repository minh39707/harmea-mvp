            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicTracking"
                }
              }
            }
          },
          "400": {
            "description": "JSON hoặc cấu trúc request không hợp lệ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "ORDER_NOT_FOUND; không tiết lộ có đơn hay không.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dữ liệu không đạt quy tắc nghiệp vụ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Quá nhiều yêu cầu; thử lại sau.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi nội bộ; không trả stack trace hay thông tin nhạy cảm.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/session": {
      "post": {
        "x-implementation-status": "planned",
        "operationId": "loginAdmin",
        "summary": "Đăng nhập một tài khoản quản trị cấu hình ngoài mã nguồn.",
        "description": "So sánh password với ADMIN_PASSWORD_HASH. Thành công sinh session32bytes, lưu SHA256 và hạn8h; rotate session khi login. Kiểm tra Origin và rate limit đăng nhập.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã đăng nhập.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSession"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "harmea_admin=<opaque>; HttpOnly; SameSite=Lax; Path=/api/admin; Max-Age=28800; Secure khi HTTPS. Local HTTP loopback được bỏ Secure."
              }
            }
          },
          "400": {
            "description": "JSON hoặc cấu trúc request không hợp lệ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS; thông báo chung.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "ORIGIN_NOT_ALLOWED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dữ liệu không đạt quy tắc nghiệp vụ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Quá nhiều yêu cầu; thử lại sau.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi nội bộ; không trả stack trace hay thông tin nhạy cảm.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "x-implementation-status": "planned",
        "operationId": "logoutAdmin",
        "summary": "Xóa session phía server và cookie.",
        "security": [
          {
            "adminCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Đã đăng xuất; cookie bị xóa."
          },
          "401": {
            "description": "Chưa đăng nhập hoặc session hết hạn.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin không được phép hoặc không đủ quyền.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
