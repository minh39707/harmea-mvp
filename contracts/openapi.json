{
  "openapi": "3.1.0",
  "info": {
    "title": "Harméa MVP API contract",
    "version": "0.1.0",
    "description": "Hợp đồng triển khai demo 28/10/2026. Chỉ /api/health có trong starter; mọi endpoint nghiệp vụ đánh dấu planned. Không có thanh toán, tài khoản khách hoặc giỏ hàng. Giá50000VND là dữ liệu giả demo; phí ship chưa báo."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000",
      "description": "API local trực tiếp"
    },
    {
      "url": "http://127.0.0.1:5173",
      "description": "Vite dev qua proxy /api"
    }
  ],
  "security": [],
  "paths": {
    "/api/health": {
      "get": {
        "x-implementation-status": "starter",
        "operationId": "getHealth",
        "summary": "Liveness của API starter; không chứng minh nghiệp vụ đã có.",
        "responses": {
          "200": {
            "description": "API đang chạy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/current": {
      "get": {
        "x-implementation-status": "planned",
        "operationId": "getCurrentProduct",
        "summary": "Lấy sản phẩm và template duy nhất đang bán.",
        "responses": {
          "200": {
            "description": "Danh mục hiện tại.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Chưa có sản phẩm đang bán.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "x-implementation-status": "planned",
        "operationId": "createOrder",
        "summary": "Tạo một đơn từ thiết kế và ảnh; chưa thanh toán.",
        "description": "FormData.append('payload', JSON.stringify(data)); photo/preview là File. Backend parse JSON, kiểm tra MIME thực/giải mã ảnh, asset kích thước, URL và product trước transaction. <=20MP và mỗi cạnh<=8192px sau decode. Toàn bộ request<=8MiB. Không tin giá hoặc ảnh preview để suy ra dữ liệu in. requestKey lặp trả409; không thực hiện replay response.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "JSON serialized theo schema CreateOrder.",
                    "x-json-schema": {
                      "$ref": "#/components/schemas/CreateOrder"
                    }
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG/PNG, <=5MiB (5242880 bytes)."
                  },
                  "preview": {
                    "type": "string",
                    "format": "binary",
                    "description": "PNG <=2MiB (2097152 bytes), ảnh proof của đúng cấu hình khách xác nhận."
                  }
                },
                "required": [
                  "payload",
                  "photo",
                  "preview"
                ]
              },
              "encoding": {
                "payload": {
                  "contentType": "text/plain"
                },
                "photo": {
                  "contentType": "image/jpeg, image/png"
                },
                "preview": {
                  "contentType": "image/png"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đơn và status event đầu tiên đã lưu; trả raw tracking token một lần.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCreated"
                }
              }
            }
          },
          "400": {
            "description": "JSON hoặc cấu trúc request không hợp lệ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "DUPLICATE_REQUEST khi requestKey trùng, hoặc PRODUCT_CHANGED khi template không còn hiện hành.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "FILE_TOO_LARGE hoặc REQUEST_TOO_LARGE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE: tệp sai định dạng hoặc không giải mã được.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dữ liệu không đạt quy tắc nghiệp vụ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Quá nhiều yêu cầu; thử lại sau.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi nội bộ; không trả stack trace hay thông tin nhạy cảm.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tracking/lookup": {
      "post": {
        "x-implementation-status": "planned",
        "operationId": "lookupTracking",
        "summary": "Tra cứu công khai bằng secret trong body.",
        "description": "Trang /track#token đọc fragment và POST body. Cache-Control:no-store và Referrer-Policy:no-referrer. Không log token/request body; rate limit. Token sai hoặc không tồn tại cùng404.",
        "requestBody": {
          "required": true,
