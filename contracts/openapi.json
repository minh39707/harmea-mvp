              },
              "height": {
                "type": "number",
                "const": 90
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "safeAreaMm": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "number",
