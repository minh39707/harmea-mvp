      "CreateOrder": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestKey": {
            "type": "string",
            "format": "uuid",
            "description": "crypto.randomUUID() tạo một lần cho lần submit; giữ nguyên khi retry. Trùng key trả 409, không trả lại raw tracking token."
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
